//@version=6
indicator("GC 1min Entry Areas", overlay=true, max_boxes_count=500)

// Input parameters
fvgMaxDistance = input.int(10, title="Max Candles from Fractal to FVG", minval=1, maxval=50)
fvgMinTicks = input.int(5, title="Minimum FVG Size (ticks)", minval=1, maxval=100)
maxEntryAreaSize = input.int(50, title="Max Entry Area Size (ticks)", minval=5, maxval=500)
enableAlerts = input.bool(true, title="Enable Alerts")
removeOverlaps = input.bool(false, title="Remove Overlapping Entry Areas (keep lowest)")

// Bill Williams Fractal Recognition
isBWFractal(mode) =>
    result = mode == 1 ? (high[4] < high[2] and high[3] <= high[2] and high[2] >= high[1] and high[2] > high[0]) : mode == -1 ? (low[4] > low[2] and low[3] >= low[2] and low[2] <= low[1] and low[2] < low[0]) : false
    result

// Detect fractals
isHighFractal = bar_index >= 4 and isBWFractal(1)
isLowFractal = bar_index >= 4 and isBWFractal(-1)

// FVG detection with minimum tick size
minGapSize = fvgMinTicks * syminfo.mintick
bullishFVG = bar_index >= 2 and (low[0] - high[2]) >= minGapSize
bearishFVG = bar_index >= 2 and (low[2] - high[0]) >= minGapSize

// Store recent fractals (last 20 of each type)
var float[] highFractals = array.new_float()
var int[] highFractalBars = array.new_int()
var float[] lowFractals = array.new_float()
var int[] lowFractalBars = array.new_int()

// Track used fractal pairs
var string[] usedFractalPairs = array.new_string()

// Track if new entry area was created (for alerts)
var bool newEntryAreaCreated = false
var float alertEntryTop = na
var float alertEntryBottom = na
var int alertDelayBars = 0  // Counter for 2-bar delay

// Add fractals to storage
if isHighFractal
    array.push(highFractals, high[2])
    array.push(highFractalBars, bar_index - 2)
    if array.size(highFractals) > 20
        array.shift(highFractals)
        array.shift(highFractalBars)

if isLowFractal
    array.push(lowFractals, low[2])
    array.push(lowFractalBars, bar_index - 2)
    if array.size(lowFractals) > 20
        array.shift(lowFractals)
        array.shift(lowFractalBars)

// Visualization boxes
var array<box> entryBoxes = array.new_box()
var array<label> entryLabels = array.new_label()

// When FVG occurs, find the closest high and low fractals
if bullishFVG or bearishFVG
    
    // Find closest high fractal before FVG
    float closestHighFractal = na
    int closestHighBar = na
    
    if array.size(highFractals) > 0
        for i = array.size(highFractals) - 1 to 0
            fractalBar = array.get(highFractalBars, i)
            if fractalBar < bar_index
                closestHighFractal := array.get(highFractals, i)
                closestHighBar := fractalBar
                break
    
    // Find closest low fractal before FVG
    float closestLowFractal = na
    int closestLowBar = na
    
    if array.size(lowFractals) > 0
        for i = array.size(lowFractals) - 1 to 0
            fractalBar = array.get(lowFractalBars, i)
            if fractalBar < bar_index
                closestLowFractal := array.get(lowFractals, i)
                closestLowBar := fractalBar
                break
    
    // Create box if we have both fractals and all conditions are met
    if not na(closestHighFractal) and not na(closestLowFractal)
        nearestFractalBar = math.max(closestHighBar, closestLowBar)
        barsFromFractal = bar_index - nearestFractalBar
        
        // Calculate entry area size in ticks
        entryAreaSize = (closestHighFractal - closestLowFractal) / syminfo.mintick
        
        // Create unique ID for this fractal pair
        pairId = str.tostring(closestHighBar) + "_" + str.tostring(closestLowBar)
        
        // Check if already used
        bool alreadyUsed = false
        if array.size(usedFractalPairs) > 0
            for p = 0 to array.size(usedFractalPairs) - 1
                if array.get(usedFractalPairs, p) == pairId
                    alreadyUsed := true
                    break
        
        // Check all conditions
        bool priceClosedAbove = close > closestHighFractal
        bool validZone = closestHighFractal > closestLowFractal
        bool withinRange = barsFromFractal <= fvgMaxDistance
        bool sizeWithinLimit = entryAreaSize <= maxEntryAreaSize
        
        if not alreadyUsed and priceClosedAbove and validZone and withinRange and sizeWithinLimit
            startBar = nearestFractalBar
            
            // Check for overlaps if removeOverlaps is enabled
            bool hasOverlap = false
            if removeOverlaps and array.size(entryBoxes) > 0
                // Check if this new entry area overlaps with any existing ones
                for j = 0 to array.size(entryBoxes) - 1
                    existingBox = array.get(entryBoxes, j)
                    existingTop = box.get_top(existingBox)
                    existingBottom = box.get_bottom(existingBox)
                    
                    // Check if ranges overlap
                    if not (closestHighFractal < existingBottom or closestLowFractal > existingTop)
                        hasOverlap := true
                        // If new entry area is lower, remove the existing one
                        if closestLowFractal < existingBottom
                            box.delete(existingBox)
                            array.remove(entryBoxes, j)
                            hasOverlap := false  // Allow new one to be created
                        break
            
            // Only create box if no overlap or if we removed the overlapping one
            if not hasOverlap
                newBox = box.new(left=startBar, top=closestHighFractal, right=bar_index + 500, bottom=closestLowFractal, bgcolor=color.new(color.blue, 75), border_color=color.new(color.blue, 50), border_width=2)
                array.push(entryBoxes, newBox)
                
                // Create timestamp label for entry areas older than 1 day
                entryTime = time[bar_index - startBar]
                daysSinceEntry = (timenow - entryTime) / 86400000  // milliseconds to days
                
                if daysSinceEntry >= 1
                    // Format: "Thu, 12/11 entry 10:22am" - using exchange timezone
                    // Note: COMEX times are in US Central Time (CT)
                    dayOfWeek = str.format("{0,date,EEE}", entryTime)
                    dateStr = str.format("{0,date,M/d}", entryTime)
                    
                    // Get hour and minute from the timestamp
                    entryHour = hour(entryTime)
                    entryMinute = minute(entryTime)
                    
                    // Format time manually to ensure correct display
                    ampm = entryHour >= 12 ? "pm" : "am"
                    displayHour = entryHour > 12 ? entryHour - 12 : (entryHour == 0 ? 12 : entryHour)
                    minuteStr = str.format("{0,number,00}", entryMinute)
                    timeStr = str.tostring(displayHour) + ":" + minuteStr + ampm
                    
                    labelText = dayOfWeek + ", " + dateStr + " entry " + timeStr
                    
                    // Position label in middle of entry area
                    labelPrice = (closestHighFractal + closestLowFractal) / 2
                    
                    newLabel = label.new(x=bar_index, y=labelPrice, text=labelText, style=label.style_none, textcolor=color.new(color.blue, 30), size=size.small)
                    array.push(entryLabels, newLabel)
                else
                    // Push na to keep arrays aligned
                    array.push(entryLabels, na)
                
                // Mark this pair as used
                array.push(usedFractalPairs, pairId)
                if array.size(usedFractalPairs) > 50
                    array.shift(usedFractalPairs)
                
                // Set flag for alert ONLY after box is successfully created
                // Check one more time that the values are different
                if closestHighFractal != closestLowFractal
                    // Only set flag if bar is confirmed (closed)
                    if barstate.isconfirmed
                        newEntryAreaCreated := true
                        alertEntryTop := closestHighFractal
                        alertEntryBottom := closestLowFractal
                        alertDelayBars := 2  // Start 2-bar delay countdown

// Manage existing boxes and labels - invalidate if price wicks through by 1 tick, or mark as touched
if array.size(entryBoxes) > 0
    for i = array.size(entryBoxes) - 1 to 0
        b = array.get(entryBoxes, i)
        top = box.get_top(b)
        bottom = box.get_bottom(b)
        
        // Update label position to follow price
        lbl = array.get(entryLabels, i)
        if not na(lbl)
            label.set_x(lbl, bar_index)
        
        // Check if price touched this entry area (entered the zone)
        if low <= top and high >= bottom
            // Change to dashed border with more transparency
            box.set_border_style(b, line.style_dashed)
            box.set_bgcolor(b, color.new(color.blue, 90))
        
        // Invalidate if low wicks below bottom by 1 tick or more
        wickedBelowBottom = low < (bottom - syminfo.mintick)
        
        if wickedBelowBottom
            box.delete(b)
            array.remove(entryBoxes, i)
            
            // Delete corresponding label
            lblToDelete = array.get(entryLabels, i)
            if not na(lblToDelete)
                label.delete(lblToDelete)
            array.remove(entryLabels, i)
            
            // If this is the entry area we're waiting to alert on, cancel the alert
            if not na(alertEntryBottom) and math.abs(bottom - (alertEntryBottom + syminfo.mintick)) < syminfo.mintick
                newEntryAreaCreated := false
                alertEntryTop := na
                alertEntryBottom := na
                alertDelayBars := 0
        else
            box.set_right(b, bar_index + 500)

// ============================================
// ALERT SECTION - Uncomment lines below to enable alerts
// ============================================
// Countdown the delay timer only when bar closes
//if barstate.isconfirmed and alertDelayBars > 0
//    alertDelayBars := alertDelayBars - 1

// Alert condition - only trigger after 2-bar delay AND entry area is still valid
//if enableAlerts and newEntryAreaCreated and alertDelayBars == 0 and barstate.isconfirmed and not na(alertEntryTop) and not na(alertEntryBottom) and alertEntryTop > alertEntryBottom
//    // Format with more decimal places to show difference
//    topStr = str.tostring(alertEntryTop, format.mintick)
//    bottomStr = str.tostring(alertEntryBottom, format.mintick)
//    alert("New GC Entry Area formed! Top: " + topStr + " Bottom: " + bottomStr, alert.freq_once_per_bar)

// Reset alert variables after alert fires (or if no alert needed)
//if barstate.isconfirmed and alertDelayBars == 0
//    newEntryAreaCreated := false
//    alertEntryTop := na
//    alertEntryBottom := na
// ============================================
// END ALERT SECTION
// ============================================

// Debug: show where fractals are detected
showFractals = input.bool(true, title="Show Fractal Markers")
plotchar(showFractals and isHighFractal, "High Fractal", "▼", location.abovebar, color.red, size=size.auto, offset=-2)
plotchar(showFractals and isLowFractal, "Low Fractal", "▲", location.belowbar, color.lime, size=size.auto, offset=-2)


plot(close)
